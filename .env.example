# Runtime identity
NODE_ENV=development
APP_ENV=local
APP_REVISION=
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:4000
BACKEND_AUDIENCE=
PORT=4000

# Private renderer invocation, independent from fake/live AI; server-only ADC
CLOUD_RENDER_ENVIRONMENT=disabled
CLOUD_SPEND_APPROVED=false
PRIVATE_RENDERER_ORIGIN=

# Provider and feature gates: committed defaults cannot spend
FAKE_MODE=true
PAID_DEMO_ENABLED=false
LIVE_ANALYSIS_ENABLED=false
LIVE_ASSEMBLY_ENABLED=false
LIVE_RENDER_ENABLED=false
LIVE_IMAGE_GENERATION_ENABLED=false
ACTIVE_SPEAKER_ENABLED=true
TREND_SIGNALS_ENABLED=false
PUBLIC_LANGUAGE_PROFILE=en
LIMIT_PROFILE=public

# Session and security
SESSION_COOKIE_NAME=__Host-clipping_session
SESSION_ACCESS_TTL_SECONDS=7200
PROCESSING_GRANT_ACTIVE_KEY_ID=
PROCESSING_GRANT_KEYS_JSON=
CSRF_ALLOWED_ORIGINS=http://localhost:3000
PROCESSING_GRANTS_ENABLED=false
ADMISSION_MAX_RECORDS=256
ADMISSION_MAX_CONCURRENT_ACTIONS=1
ADMISSION_MAX_PROCESS_DISPATCHES=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_TIMEOUT_MS=5000

# Google: server-only key; live media transfer requires explicit approval
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=180000
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_SDK_MAX_RETRIES=0
GEMINI_MAX_CALLS=2
GEMINI_TRANSFER_APPROVED=false
GEMINI_PAID_PROJECT_CONFIRMED=false

# Public limits and admission ceilings
MAX_SOURCE_BYTES=524288000
MAX_SOURCE_SECONDS=1200
MAX_CLIP_SECONDS=60
MAX_FACE_TRACKS_PER_SHOT=4
MAX_VISUAL_CUES_PER_CLIP=3
MAX_IMAGE_CALLS_PER_ASSEMBLY=3
MAX_VISUAL_COVERAGE_PERCENT=45
MAX_RENDER_ATTEMPTS_PER_SESSION=1
MAX_CONCURRENT_ANALYSES=1
MAX_CONCURRENT_ASSEMBLIES=1
API_MAX_INSTANCES=1
FRONTEND_MAX_INSTANCES=2
RATE_WINDOW_SECONDS=300
RATE_GRANT_MAX=3
RATE_ANALYSIS_MAX=1
RATE_ASSEMBLY_MAX=1
