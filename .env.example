# Runtime identity
NODE_ENV=development
APP_ENV=local
APP_REVISION=
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:4000
BACKEND_AUDIENCE=
PORT=4000

# Provider and feature gates: committed defaults cannot spend
PROVIDER_MODE=fake
PAID_DEMO_ENABLED=false
LIVE_UPLOAD_ENABLED=false
LIVE_ANALYSIS_ENABLED=false
LIVE_ASSEMBLY_ENABLED=false
LIVE_IMAGE_GENERATION_ENABLED=false
LIVE_RENDER_ENABLED=false
ACTIVE_SPEAKER_ENABLED=true
TREND_SIGNALS_ENABLED=false
PUBLIC_LANGUAGE_PROFILE=en
LIMIT_PROFILE=public

# Session and security
SESSION_COOKIE_NAME=__Host-clipping_session
SESSION_ACCESS_TTL_SECONDS=7200
PROCESSING_GRANT_ACTIVE_KEY_ID=
PROCESSING_GRANT_KEYS_JSON=
CSRF_ALLOWED_ORIGINS=http://localhost:3000
IDEMPOTENCY_TTL_SECONDS=86400
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_TIMEOUT_MS=5000

# Storage and jobs
GCP_PROJECT_ID=
GCP_REGION=
TEMP_MEDIA_BUCKET=
SAMPLE_MEDIA_OBJECT=
SAMPLE_MEDIA_GENERATION=
SAMPLE_MEDIA_SHA256=
MEDIA_JOB_NAME=
MEDIA_JOB_SERVICE_ACCOUNT=
UPLOAD_AUTH_TTL_SECONDS=900
DOWNLOAD_AUTH_TTL_SECONDS=300
OBJECT_LIFECYCLE_DAYS=1
JOB_ANALYSIS_TIMEOUT_SECONDS=900
JOB_ASSEMBLY_TIMEOUT_SECONDS=900
JOB_RENDER_TIMEOUT_SECONDS=900
JOB_CPU=2
JOB_MEMORY_MIB=4096
JOB_EPHEMERAL_STORAGE_MIB=10240
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe
FONT_DIR=/app/fonts
PYTHON_PATH=/opt/venv/bin/python
ACTIVE_SPEAKER_ENTRYPOINT=/app/vision/active_speaker.py
ACTIVE_SPEAKER_MODEL=light-asd
ACTIVE_SPEAKER_WEIGHTS_PATH=/app/models/light-asd/model.pth
ACTIVE_SPEAKER_WEIGHTS_SHA256=
ACTIVE_SPEAKER_TIMEOUT_MS=240000
SCENE_DETECT_PROFILE=podcast-cuts-v1

# OpenAI: the owner supplies secrets only in ignored local/cloud storage
OPENAI_API_KEY=
OPENAI_CLIP_MODEL=gpt-6-sol
OPENAI_VISUAL_MODEL=gpt-6-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT_TOKENS_CLIP=3000
OPENAI_MAX_OUTPUT_TOKENS_VISUAL=1800
OPENAI_IMAGE_TIMEOUT_MS=120000
OPENAI_IMAGE_MAX_CALLS=3
OPENAI_STORE=false
OPENAI_SDK_MAX_RETRIES=0

# Deepgram: the owner supplies secrets only in ignored local/cloud storage
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_DIARIZE=true
DEEPGRAM_TIMEOUT_MS=360000
DEEPGRAM_SDK_MAX_RETRIES=0

# Public limits and admission ceilings
MAX_SOURCE_BYTES=524288000
MAX_SOURCE_SECONDS=1200
MAX_CLIP_SECONDS=60
MAX_FACE_TRACKS_PER_SHOT=4
MAX_VISUAL_CUES_PER_CLIP=3
MAX_IMAGE_CALLS_PER_ASSEMBLY=3
MAX_VISUAL_COVERAGE_PERCENT=45
MAX_RENDER_ATTEMPTS_PER_SESSION=1
MAX_CONCURRENT_ANALYSES=1
MAX_CONCURRENT_ASSEMBLIES=1
MAX_CONCURRENT_RENDERS=1
API_MAX_INSTANCES=1
FRONTEND_MAX_INSTANCES=2
RATE_WINDOW_SECONDS=300
RATE_UPLOAD_AUTH_MAX=3
RATE_ANALYSIS_MAX=1
RATE_ASSEMBLY_MAX=1
RATE_RENDER_MAX=1
