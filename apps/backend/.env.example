# Backend configuration. Never commit .env.local or populated private entries.
# Normal defaults are real and paid-on; tests explicitly force fake/paid-off.
# PAID_DEMO_ENABLED=false overrides all four approvals and paid capabilities.
FAKE_MODE=false
PAID_DEMO_ENABLED=true

CLOUD_SPEND_APPROVED=true
GEMINI_TRANSFER_APPROVED=true
GEMINI_IMAGE_GENERATION_APPROVED=true
GEMINI_PAID_PROJECT_CONFIRMED=true

# Analysis, assembly and final rendering are enabled in code when paid is on.
APP_ENV=local
APP_REVISION=
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:4000
BACKEND_AUDIENCE=
FRONTEND_CALLER_EMAIL=
# Hosted launch gate only; leave false for normal localhost and initial hosted checks.
PUBLIC_PAID_PROCESSING_APPROVED=false
# Hosted-only CL-114: private usage object; verified native Cloud Run client ingress.
# Leave these unset/false locally. No runtime bucket creation or quota reset.
HOSTED_DEMO_LEDGER_BUCKET=
HOSTED_DEMO_IP_VERIFIED=false
# Private backend only: comma-separated exact owner IPs. Blank means no exemptions.
# Populate .env.local manually; hosted deployment injects the same private key.
HOSTED_DEMO_OWNER_IPS=
PRIVATE_RENDERER_ORIGIN=
TURNSTILE_EXPECTED_HOSTNAME=
RETAINED_SAMPLE_BUCKET=
RETAINED_SAMPLE_OBJECT=
RETAINED_SAMPLE_GENERATION=
RETAINED_SAMPLE_BYTES=

GEMINI_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PROCESSING_GRANT_KEY=
