# Backend configuration. Never commit .env.local or populated private entries.
# Normal defaults are real and paid-on; tests explicitly force fake/paid-off.
# PAID_DEMO_ENABLED=false overrides all four approvals and paid capabilities.
FAKE_MODE=false
PAID_DEMO_ENABLED=true

CLOUD_SPEND_APPROVED=true
GEMINI_TRANSFER_APPROVED=true
GEMINI_IMAGE_GENERATION_APPROVED=true
GEMINI_PAID_PROJECT_CONFIRMED=true

# Keep assembly until the independently approved final-renderer rollout.
PAID_VALIDATION_STAGE=assembly
APP_ENV=local
APP_REVISION=
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:4000
BACKEND_AUDIENCE=
PRIVATE_RENDERER_ORIGIN=
TURNSTILE_EXPECTED_HOSTNAME=
RETAINED_SAMPLE_BUCKET=
RETAINED_SAMPLE_OBJECT=
RETAINED_SAMPLE_GENERATION=
RETAINED_SAMPLE_BYTES=

GEMINI_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PROCESSING_GRANT_KEY=
