# Separate renderer service environment; never copy the backend env or AI key.
NODE_ENV=production
PORT=8080
RENDERER_ENABLED=false
CLOUD_SPEND_APPROVED=false
REMOTION_LICENSE_CONFIRMED=false
RENDERER_BUCKET=
RENDERER_AUDIENCE=
RENDERER_CALLER_EMAIL=
RENDERER_EXPIRY_CALLER_EMAIL=
RENDERER_CLEANUP_KEY_FILE=
FRONTEND_ORIGIN=http://localhost:3000
# Optional exact HTTPS hosted frontend origin; preserves local upload support.
HOSTED_FRONTEND_ORIGIN=
# Baked image paths; binaries are never downloaded at service startup.
CHROMIUM_PATH=/opt/clipbuilder/chromium/chrome-headless-shell
FFMPEG_PATH=/opt/clipbuilder/compositor/ffmpeg
FFPROBE_PATH=/opt/clipbuilder/compositor/ffprobe
REMOTION_BUNDLE_PATH=/app/bundle
