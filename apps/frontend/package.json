{
  "name": "@clipbuilder/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "format": "prettier --check --ignore-path ../../.prettierignore .",
    "format:write": "prettier --write --ignore-path ../../.prettierignore .",
    "lint": "eslint .",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "test:media": "node feasibility/browser-media/server.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clipbuilder/contracts": "workspace:*",
    "@clipbuilder/composition": "workspace:*",
    "@remotion/player": "4.0.532",
    "lucide-react": "1.49.0",
    "mediabunny": "1.61.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
