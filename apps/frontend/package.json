{
  "name": "@clipbuilder/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build && node --experimental-strip-types scripts/verify-release-artifact.ts --local-build",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "film:capture": "node scripts/capture-product-film.mjs",
    "film:poster": "node --experimental-strip-types scripts/render-product-film-poster.mjs",
    "film:studio": "remotion studio src/features/product-film/studio.tsx --no-open --port=3002",
    "format": "prettier --check --ignore-path ../../.prettierignore .",
    "format:write": "prettier --write --ignore-path ../../.prettierignore .",
    "lint": "eslint .",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "test:media": "vitest run feasibility/browser-audio feasibility/browser-media",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:release-artifact": "node --experimental-strip-types scripts/verify-release-artifact.ts"
  },
  "dependencies": {
    "@clipbuilder/composition": "workspace:*",
    "@clipbuilder/contracts": "workspace:*",
    "@remotion/player": "4.0.534",
    "lucide-react": "1.49.0",
    "mediabunny": "1.61.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
