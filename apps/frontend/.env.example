# Next.js loads apps/frontend/.env.local automatically; keep it out of Git.
# Normal localhost uses fixed origins and ignores the optional hosted connection.
# Never place provider credentials or private settings in NEXT_PUBLIC_*.
APP_ENV=local
# Hosted-only: exact .run.app origins; production frontend may use the owner domain.
# Private API origin/audience always stay HTTPS .run.app.
FRONTEND_ORIGIN=
PRIVATE_BACKEND_ORIGIN=
BACKEND_AUDIENCE=
# Hosted-only. Verify native Cloud Run's final appended client IP before enabling.
HOSTED_DEMO_IP_VERIFIED=false
