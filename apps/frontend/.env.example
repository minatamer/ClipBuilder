# Next.js loads apps/frontend/.env.local automatically; keep it out of Git.
# Normal localhost uses fixed origins and ignores the optional hosted connection.
# Never place provider credentials or private settings in NEXT_PUBLIC_*.
APP_ENV=local
# Hosted-only server settings: exact frontend/private API HTTPS .run.app origins.
FRONTEND_ORIGIN=
PRIVATE_BACKEND_ORIGIN=
BACKEND_AUDIENCE=
