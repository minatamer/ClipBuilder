{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx"
  },
  "include": [
    "apps/*/local/**/*.ts",
    "apps/*/local/**/*.tsx",
    "packages/*/local/**/*.ts",
    "packages/*/local/**/*.tsx",
    "scripts/local-test.config.ts"
  ],
  "exclude": ["**/node_modules"]
}
