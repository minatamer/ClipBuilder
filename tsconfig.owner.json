{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx"
  },
  "include": [
    "apps/*/owner/**/*.ts",
    "apps/*/owner/**/*.tsx",
    "packages/*/owner/**/*.ts",
    "packages/*/owner/**/*.tsx",
    "scripts/owner-test.config.ts"
  ],
  "exclude": ["**/node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
