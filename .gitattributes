# Keep repository text deterministic across operating systems.
* text=auto eol=lf

# Never apply line-ending normalization to binary assets.
*.avif binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.webp binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.mov binary
*.webm binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
